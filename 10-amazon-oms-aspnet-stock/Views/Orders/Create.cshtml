@model AmazonOMS.Models.Order
@{
    var products = (IEnumerable<AmazonOMS.Models.Product>)ViewBag.Products;
    var selectedProduct = ViewBag.Product as AmazonOMS.Models.Product;
}

<form asp-action="Create" method="post">
    <div asp-validation-summary="All"></div>
    <div class="form-group">
        <label for="OrderDate">Order Date</label>
        <input type="date" class="form-control" id="OrderDate" name="OrderDate" value="@Model.OrderDate.ToString("yyyy-MM-dd")" />
    </div>

    <div class="form-group">
        <label for="Status">Status</label>
        <input type="text" class="form-control" id="Status" name="Status" value="Pending" readonly />
    </div>

    <h3>Order Details</h3>

        <div>
            <label>Product:</label>
            <select name="productID">
                @foreach (var product in products)
            {
                <option value="@product.ProductID" selected="@(selectedProduct?.ProductID == product.ProductID)">@product.Name</option>
            }
            </select>
        </div>

        <div>
            <label>Quantity:</label>
            <input type="number" name="quantity" min="1" required />
        </div>

        <button type="submit">Place Order</button>
    </form>
