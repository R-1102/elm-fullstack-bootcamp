@model IEnumerable<AmazonOMS.Models.Product>

    <h1>Product List</h1>
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock Quantity</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Category</td>
                <td>@product.Price</td>
                <td>@product.StockQuantity</td>
                <td><a href="@Url.Action("Create", "Orders", new { id = product.ProductID })">Buy</a></td>
            </tr>
        }
        </tbody>
    </table>
